DATABASE_URL=sqlite:///${WEREWOLF_AGENT_HOME:-/root/.werewolf-agent}/evolution.db
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
WEREWOLF_AGENT_HOME=/root/.werewolf-agent
PROVIDER_PUBLIC_HOST=127.0.0.1
PROVIDER_PUBLIC_HTTP_PORT=8083
PROVIDER_PUBLIC_WS_PORT=8082
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=werewolf_app
MYSQL_PASS=replace-with-a-strong-password
MYSQL_DB=werewolf
